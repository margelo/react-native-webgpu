{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build:android": {
      "env": ["JAVA_HOME", "ANDROID_NDK", "ANDROID_SDK", "ANDROID_HOME"],
      "outputs": [
        "apps/*/android",
        "!apps/*/android/.gradle",
        "!apps/*/android/build",
        "!apps/*/android/app/build"
      ],
      "inputs": [
        "**/package.json",
        "packages/webgpu/android",
        "!packages/webgpu/android/build",
        "packages/webgpu/cpp/**",
        "apps/*/android/**",
        "apps/*/android/app/build.gradle",
        "apps/*/android/build.gradle",
        "apps/*/android/gradle.properties",
        "apps/*/android/local.properties",
        "!apps/*/android/.gradle",
        "!apps/*/android/build",
        "!apps/*/android/app/build"
      ]
    },
    "build:ios": {
      "outputs": [
        "apps/*/ios/build"
      ],
      "inputs": [
        "**/package.json",
        "packages/webgpu/Package.swift",
        "packages/webgpu/cpp/**",
        "packages/webgpu/apple/**",
        "apps/*/package.json",
        "apps/*/ios",
        "!apps/*/ios/build"
      ]
    },
    "lint": {},
    "tsc": {},
    "build": {
      "outputs": ["lib/**", "plugin/build/**", ".next/**", "out/**"]
    },
    "build:docs": {
      "env": ["GITHUB_PAGES"],
      "dependsOn": ["react-native-webgpu#build"],
      "outputs": [".next/**", "out/**"],
      "inputs": [
        "**/*",
        "../../packages/webgpu/src/**",
        "!**/.next/**",
        "!**/out/**"
      ]
    }
  }
}
